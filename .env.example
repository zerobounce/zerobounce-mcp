# ZeroBounce MCP server settings. The server reads these from the environment; it does
# not load a .env file itself, so export them or put them in your MCP client's config.
# Never commit a real key.

# stdio mode: the validation API key. Get it at https://www.zerobounce.net/docs/api-dashboard
ZEROBOUNCE_API_KEY=your_api_key_here

# Optional: the Warmup API key. Warmup is a separate product with its own key;
# without it the Warmup tools are not offered.
# ZEROBOUNCE_WARMUP_API_KEY=

# Optional: region (us, eu) or an explicit https:// API URL.
# ZEROBOUNCE_API_URL=

# Optional: an explicit https:// Warmup API URL, for a test host.
# ZEROBOUNCE_WARMUP_API_URL=

# HTTP mode only. In HTTP mode each request sends its own key in a header and the
# keys above are not used.
# MCP_TRANSPORT=http
# PORT=3000
# Binding anything but loopback also requires MCP_TLS_TERMINATED=true.
# MCP_HOST=127.0.0.1
# MCP_TLS_TERMINATED=
