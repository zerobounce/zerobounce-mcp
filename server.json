{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.zerobounce/zerobounce-mcp",
  "title": "ZeroBounce",
  "description": "Validate email addresses, find contacts, search domains, and score emails with ZeroBounce.",
  "repository": {
    "url": "https://github.com/zerobounce/zerobounce-mcp",
    "source": "github"
  },
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@zerobounce/mcp",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ZEROBOUNCE_API_KEY",
          "description": "ZeroBounce API key",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
